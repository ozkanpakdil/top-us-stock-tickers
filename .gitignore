.DS_Store

# Full-history CSV is generated from the per-ticker JSON archives by
# backfill_history.py and published as a GitHub Actions artifact (downloadable
# from the daily workflow run). It can be far too large to commit — a full
# backfill is hundreds of MB and grows daily — so it stays out of git.
# history.sql (the daily incremental snapshot) IS committed so the repo always
# has the latest full SQL dump available.
tickers/history.csv

# Per-ticker OHLC archives. Published to an orphan `data` branch by the daily
# workflow and served to the static site via the jsDelivr CDN — never committed
# to `main` (thousands of files / ~1GB would bloat the repo).
ohlc/
